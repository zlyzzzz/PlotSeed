{
  "name": "plotseed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test tests/core.test.js tests/metrics.test.js tests/library.test.js tests/providers.test.js tests/navigation.test.js tests/story-markers.test.js tests/trash.test.js",
    "dev": "vite --configLoader native --host 127.0.0.1",
    "server": "node --watch server/index.js",
    "build": "vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "docx": "^9.15.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
